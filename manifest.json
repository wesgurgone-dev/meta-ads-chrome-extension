{
  "manifest_version": 3,
  "name": "Meta Ads Library Saver",
  "version": "0.1.0",
  "description": "Capture ads from the Meta Ad Library, save them into your own lists, download creatives, and see every stat Meta exposes (spend, reach, longevity).",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "sidePanel",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ads Saver"
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library*",
        "https://web.facebook.com/ads/library*"
      ],
      "js": [
        "content/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library*",
        "https://web.facebook.com/ads/library*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel/panel.html"
  }
}
